# Local development defaults only. Do not use mock auth in a deployed environment.
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_MOCK_ADMIN_EMAIL=admin@example.com

# GLI-11 integration boundary. No trailing slash is required.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
NEXT_PUBLIC_AUTH_SESSION_PATH=/auth/me
NEXT_PUBLIC_AUTH_LOGOUT_PATH=/auth/logout
