    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "jsdom": "27.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
